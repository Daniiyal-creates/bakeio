# Bakeio WhatsApp worker configuration.
# Copy to .env (or paste into your host's environment settings) and fill in.

# Your Bakeio backend URL. Same value the app uses as EXPO_PUBLIC_BILT_URL.
BILT_URL=https://your-project-id.cloud.bilt.me

# Public anon key. Same value the app uses as EXPO_PUBLIC_BILT_ANON_KEY.
BILT_ANON_KEY=

# Service key. SECRET — grants full database access, so it lives only here,
# never in the mobile app. Find it in your Bilt project settings.
BILT_SERVICE_KEY=

# Port for the /health endpoint. Most hosts set this for you.
PORT=8080

# How often the worker looks for connect/disconnect requests, in milliseconds.
POLL_INTERVAL_MS=5000
